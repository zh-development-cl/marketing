{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/inicio" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known?doc=recurso" },
    { "source": "/.well-known/oauth-protected-resource/(.*)", "destination": "/api/well-known?doc=recurso" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known?doc=servidor" },
    { "source": "/.well-known/oauth-authorization-server/(.*)", "destination": "/api/well-known?doc=servidor" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
